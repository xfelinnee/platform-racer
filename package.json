{
  "name": "platform-racer",
  "productName": "Platform Racer",
  "version": "1.1.9",
  "description": "A fast neon platformer with profiles, a coin shop, and (soon) multiplayer.",
  "author": {
    "name": "Max Stupin"
  },
  "main": "electron/main.js",
  "scripts": {
    "start": "node electron/dev.js",
    "start:plain": "electron .",
    "dist": "electron-builder",
    "publish": "node scripts/release.js",
    "release:patch": "npm version patch && node scripts/release.js",
    "release:minor": "npm version minor && node scripts/release.js"
  },
  "devDependencies": {
    "electron": "31.7.7",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "build": {
    "appId": "com.maxstupin.platformracer",
    "productName": "Platform Racer",
    "files": [
      "electron/**/*",
      "index.html",
      "css/**/*",
      "js/**/*",
      "assets/**/*"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    },
    "mac": {
      "icon": "assets/icon.png",
      "target": [
        "dmg"
      ],
      "category": "public.app-category.games"
    },
    "linux": {
      "icon": "assets/icon-512.png",
      "target": [
        "AppImage"
      ],
      "category": "Game"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "xfelinnee",
        "repo": "platform-racer"
      }
    ]
  }
}
